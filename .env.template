# Spotify (developer.spotify.com/dashboard -> tu app -> Settings)
SPOTIPY_CLIENT_ID=tu_client_id_aqui
SPOTIPY_CLIENT_SECRET=tu_client_secret_aqui
# Debe estar registrado EXACTAMENTE igual en "Redirect URIs" de la app.
# Spotify exige 127.0.0.1 (no "localhost") o https.
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8978/callback

# Last.fm (last.fm/api) - opcional, usado para etiquetas de género
LASTFM_API_KEY=tu_api_key_aqui
LASTFM_SHARED_SECRET=tu_shared_secret_aqui

# Carpeta de datos (caché, merges, token). Relativa a la raíz del proyecto.
# DATA_DIR=data
